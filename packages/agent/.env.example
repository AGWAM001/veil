# ── Model: pick ONE provider ─────────────────────────────────────────────────
# Free: set OPENROUTER_API_KEY (openrouter.ai → Keys). Uses free models with
# automatic failover. Free tier = 20 requests/min and 50/day; buying $10 of
# credit once raises it to 1,000/day. One chat message costs 2–4 requests.
OPENROUTER_API_KEY=
# Optional: free model ids in preference order (the free list changes daily —
# check https://openrouter.ai/models?max_price=0&supported_parameters=tools).
# AGENT_MODELS=qwen/qwen3.8-27b:free,google/gemma-4-31b-it:free,nvidia/nemotron-3-super-120b-a12b:free

# Paid (better tool use): leave OPENROUTER_API_KEY empty and set these instead.
ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-opus-5

# Force one explicitly if both keys are set: anthropic | openrouter
# LLM_PROVIDER=

# ── Stellar ──────────────────────────────────────────────────────────────────
# mainnet (default) or testnet. Horizon, Soroban RPC, the network passphrase and
# the x402 network all follow from this one setting.
STELLAR_NETWORK=testnet
# Only to override a single endpoint:
# HORIZON_URL=
# SOROBAN_RPC_URL=

# Agent keypair — Ed25519 key used ONLY for x402 payments
# Generate: node -e "const {Keypair}=require('@stellar/stellar-sdk');const k=Keypair.random();console.log(k.secret(),k.publicKey())"
AGENT_KEYPAIR_SECRET=S...

# ── x402 auto-payments from the agent's key (shared by every user) ───────────
# Most the agent pays for one request, in USDC. 0 turns auto-payment off.
X402_MAX_AUTOPAY_USDC=0.01
# Optional comma-separated recipients the agent may pay (e.g. your Lens/Wraith).
# X402_ALLOWED_PAYTO=

# APIs the agent calls (with x402 gating)
ORACLE_URL=http://localhost:3003
WRAITH_URL=https://wraith-0jo1.onrender.com

# ── Server ───────────────────────────────────────────────────────────────────
AGENT_PORT=3001
# Comma-separated allowed origins for CORS + the WS handshake. In production
# include the web wallet AND the agent's own URL: the mobile app's WebSocket
# sends an Origin derived from the URL it connects to.
#   ALLOWED_ORIGIN=https://app.useveilapp.xyz,https://veil-agent.onrender.com
ALLOWED_ORIGIN=http://localhost:3000
# Shared bearer token for NON-browser clients (curl, server-to-server). Requests
# with no Origin header must present this via an `x-agent-token` header or a
# `?token=` query param. Leave unset to close origin-less access entirely.
# AGENT_ACCESS_TOKEN=
