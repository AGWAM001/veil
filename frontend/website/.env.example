# Veil Website — Environment Variables
# Copy to .env.local and fill in your values

# Supabase project for the /waitlist early-access signups.
# The URL and anon key used to be hardcoded in lib/supabase.ts; they are now
# read from these variables. Without them the waitlist form shows its error
# state instead of submitting.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
